AUTH_SECRET="" # Set to a secure random value. Read more: https://authjs.dev/getting-started/deployment
AUTH_TRUST_HOST=true # Local/proxy testing only; remove in production unless your host/proxy is trusted
HMAC_SECRET_KEY='some-secret' # create this by running `openssl rand -base64 32`
AUTH_URL='' # Set to your ngrok URL for testing (e.g. https://xxxx.ngrok-free.dev), or your production URL after deploy
NEXT_PUBLIC_APP_ID='app_1234567890' # APP ID from the developer portal
RP_SIGNING_KEY='' # RP signing key from the Developer Portal (IDKit / Relying Party)
RP_ID='' # Your relying party id

# Tanda W8 shell targets (defaults in src/config/tanda.ts; set to override)
NEXT_PUBLIC_TANDA_CHAIN_ID='4801' # 4801 rehearsal / 480 W9 mainnet
NEXT_PUBLIC_TANDA_FACTORY='0x70A5dC7Ea69D19618335D89d84a32c2a605c2Ac6'
NEXT_PUBLIC_TANDA_IMPL='0x1Cb98A8Cd9FF8058DD327d505bc80eC73Cca27A5'
NEXT_PUBLIC_TANDA_USDC='0x66145f38cBAC35Ca6F1Dfb4914dF98F1614aeA88'
NEXT_PUBLIC_TANDA_LEGACY_BILL='0x8644095B9722a41281314158006d194C59ab9b12'

# W10 notifications lane (src/app/api/notify + NotificationConsent)
# MINIKIT_API_KEY: Developer Portal -> your app -> Advanced -> API Keys (server-side only; NEVER NEXT_PUBLIC_*)
# Requires portal Advanced toggle "notifications" enabled for the app, and user-side
# MiniKit.requestPermission grant (NotificationConsent banner handles the UX).
MINIKIT_API_KEY=''
MINIKIT_APP_ID='app_1234567890' # same as NEXT_PUBLIC_APP_ID unless you run separate app ids
NOTIFY_INTERNAL_KEY='' # random secret for cron/indexer callers of /api/notify (openssl rand -hex 32)
