# Build-context hygiene for hosting/Dockerfile (context = repo root).
# node_modules is rebuilt inside the image from the lockfile; shipping the
# Windows host's tree would poison the Linux image (native deps, line endings).
node_modules
.next
.out
.nitro
.cache
coverage

.git
.gitignore
.worktrees
.github

# host scratch
scratch
*.log
npm-ci.log

# local TLS staging material must never enter an image or the context
hosting/staging/certs

# editor / OS noise
.DS_Store
Thumbs.db
*.tsbuildinfo
